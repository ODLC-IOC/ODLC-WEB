# Equivalente en Hostinger (Apache) de netlify.toml
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <If "%{REQUEST_URI} =~ m#^/assets/img/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/(css|js)/#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </If>
</IfModule>

RewriteEngine On
# Forzar https y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://odlc.es%{REQUEST_URI} [L,R=301]

# Páginas antiguas o retiradas
Redirect 301 /metodo-orden.html /metodo-odlc.html
Redirect 301 /indice-orden.html /calculadora.html
Redirect 301 /indice-odlc.html /calculadora.html
Redirect 301 /barometro-odlc.html /calculadora.html
Redirect 301 /simulador.html /calculadora.html
Redirect 301 /sobre-isabel-olivares.html /quienes-somos.html
Redirect 301 /diagnostico.html /reservar-sesion.html
Redirect 301 /servicios/implantacion-operativa-digital.html /servicios/puesta-en-marcha.html
Redirect 301 /servicios/secretaria-societaria-consejo.html /servicios/orden-continuo.html
Redirect 301 /servicios/compliance-pbc-titularidad-real.html /servicios/orden-continuo.html
Redirect 301 /servicios/seguros-sociedades-activos.html /servicios/orden-continuo.html

# Tarjeta digital y tarjeta QR con URL limpia (05/11/2026)
AddType "text/vcard; charset=utf-8" .vcf
RewriteRule ^vcard_ioc/?$ vcard_ioc.html [L]
RewriteRule ^qr_ioc/?$ qr_ioc.html [L]
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(vcard_ioc|qr_ioc)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
# Reuniones y reservas: viven en citas.odlc.es (carpeta citas/)
RewriteRule ^reuniones/?$ https://citas.odlc.es/panel [R=302,L]
RewriteRule ^cita/?$ https://citas.odlc.es/ [R=302,L]
